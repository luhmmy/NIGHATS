# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (Docker, see docker-compose.yml): port 5433 to avoid clashing with
# any Postgres already on 5432.
# Vercel + Neon/Supabase: use the pooled connection string they give you.
DATABASE_URL="postgresql://nighats:nighats@localhost:5433/nighats?schema=public"

# Direct (non-pooled) connection — used by Prisma Migrate. On Neon/Supabase
# this is the "direct" URL. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://nighats:nighats@localhost:5433/nighats?schema=public"

# Auth.js secret — used to sign/encrypt session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Canonical URL of the app (used by Auth.js for callbacks & cookie security).
# Dev: http://localhost:3100   Prod: https://your-domain
AUTH_URL="http://localhost:3100"

# Credentials for the initial SUPER_ADMIN created by `npm run db:seed`.
# Change immediately after first login.
SEED_ADMIN_EMAIL="admin@nighats.dev"
SEED_ADMIN_PASSWORD="change-me-ChangeMe!2027"

# Set to "production" in prod so cookies get the __Secure- prefix + secure flag.
NODE_ENV="development"

# Unguessable secret admin route endpoint (must not be guessable)
# e.g. "hq-7f9a2b4c8e1d" or any random alphanumeric token
ADMIN_SECRET_PATH="hq-7f9a2b4c8e1d"
NEXT_PUBLIC_ADMIN_SECRET_PATH="hq-7f9a2b4c8e1d"
